<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Lets the native media players reach the local dev backend over plain
         HTTP. See res/xml/network_security_config.xml — it is scoped to
         localhost and 10.0.2.2, and this manifest is debug-only, so release
         builds keep Android's default "TLS everywhere". -->
    <application android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
