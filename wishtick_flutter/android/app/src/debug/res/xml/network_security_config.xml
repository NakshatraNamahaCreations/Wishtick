<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only.

  Android blocks cleartext HTTP by default from API 28. Dart's own HTTP stack
  (`dart:io`, and so Dio and Image.network) does not go through this policy, so
  the API and remote images work over http://localhost:3000 without it — but
  ExoPlayer, which backs just_audio and video_player, is native and does. A
  voice note or a video served by the local dev backend simply fails to open.

  Scoped to the two hosts a dev backend is ever reached on: `localhost` via
  `adb reverse`, and `10.0.2.2` from an emulator. Everything else, in debug and
  in release alike, still requires TLS.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
