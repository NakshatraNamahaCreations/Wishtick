<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      Reading the address book so a host can pick guests by name instead of
      typing numbers. Asked for at the moment it is used, never at launch, and
      only after the in-app explanation the host answers OK to — Android
      remembers a refusal, so a prompt out of nowhere costs the feature for
      good. Nothing is written back, so there is no WRITE_CONTACTS here.
    -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!--
      Android 13+ asks before any notification can be shown; 12 and below grant
      it implicitly. firebase_messaging's own manifest already merges this in,
      so the APK has had it all along — declaring it here is what makes it
      reviewable from this file rather than from a build artefact. The prompt
      itself is raised by PushRegistrar.onSignedIn(), which treats a refusal as
      an answer rather than an error.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application
        android:label="wishtick_flutter"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- Hands incoming links to Flutter's own router (go_router)
                 rather than to the platform's default route handling. Must sit
                 inside <activity>: at <application> level it is silently
                 ignored and every deep link opens the app at its start route
                 instead of the linked one. -->
            <meta-data android:name="flutter_deeplinking_enabled" android:value="true"/>

            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- App Links. `autoVerify` makes Android fetch
                 https://wishtick.com/.well-known/assetlinks.json at install time;
                 until that file is hosted these open in the browser instead,
                 which is the correct fallback and is also how somebody without
                 the app reaches the store (the *site* redirects them — an app
                 that is not installed cannot redirect anything).

                 Scoped to the share prefixes rather than the whole host: a bare
                 `android:host` would have the app swallow every link to the
                 marketing site, including pages it has no screen for. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https" android:host="wishtick.com"/>
                <data android:scheme="https" android:host="www.wishtick.com"/>
                <!-- Keep in step with AppLinks in lib/core/router/deep_links.dart. -->
                <data android:pathPrefix="/i/"/>
                <data android:pathPrefix="/e/"/>
                <data android:pathPrefix="/w/"/>
                <data android:pathPrefix="/m/"/>
            </intent-filter>

            <!-- Custom scheme. Not a substitute for the App Link — it cannot be
                 tapped from a chat by someone without the app, and offers no
                 store fallback — but it needs no domain verification, so it is
                 what makes the routing testable before the site exists. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="wishtick"/>
            </intent-filter>
        </activity>
        <!--
          How the system draws a notification that arrives while the app is
          backgrounded or dead — the case the app never sees, so nothing in
          Dart can style it.

          The channel id must match kNotificationChannelId in
          lib/core/push/local_notifications.dart. Same channel for both paths
          means one entry in the OS notification settings; two ids would give
          the reader two switches for one kind of notification, and muting one
          would look like muting both. Without this line Android 8+ files
          background notifications under a "Miscellaneous" fallback instead.

          The icon is drawn as a silhouette — Android keeps the alpha and
          discards the colour — so it has to be a white-on-transparent mark,
          not the launcher icon, which would come out a white square.
        -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="wishtick_default" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_accent" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
