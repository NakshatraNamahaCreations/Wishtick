{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Wishtick (real API)",
      "request": "launch",
      "type": "dart",
      "program": "${workspaceFolder}/wishtick_flutter/lib/main.dart",
      "cwd": "${workspaceFolder}/wishtick_flutter",
      "args": [
        "--dart-define=WISHTICK_API_BASE_URL=http://10.0.2.2:3000"
      ]
    },
    {
      // localhost, not a LAN IP: "adb reverse" (run automatically below)
      // forwards the physical device's own localhost:3000 to this machine's
      // backend over USB, so this keeps working across Wi-Fi/IP changes —
      // the previous hardcoded LAN address went stale the moment this
      // machine's DHCP lease changed.
      "name": "Wishtick (real API — physical device)",
      "request": "launch",
      "type": "dart",
      "program": "${workspaceFolder}/wishtick_flutter/lib/main.dart",
      "cwd": "${workspaceFolder}/wishtick_flutter",
      "preLaunchTask": "adb reverse backend port",
      "args": [
        "--dart-define=WISHTICK_API_BASE_URL=http://localhost:3000"
      ]
    },
    {
      // Same physical device, no cable. Prompts for the address rather than
      // storing one: a LAN IP is handed out by DHCP, and the last time one was
      // hardcoded here it went stale the moment the lease changed. The prompt
      // makes a stale address impossible to miss — you retype it or you don't
      // launch.
      //
      // The phone and this machine must be on the *same* network. Ethernet and
      // Wi-Fi are often separate subnets that do not route to each other, so
      // "both are in the building" is not enough; check that the address below
      // and the phone's own IP share the first three octets.
      "name": "Wishtick (real API — device over Wi-Fi)",
      "request": "launch",
      "type": "dart",
      "program": "${workspaceFolder}/wishtick_flutter/lib/main.dart",
      "cwd": "${workspaceFolder}/wishtick_flutter",
      "args": [
        "--dart-define=WISHTICK_API_BASE_URL=http://${input:lanHost}:3000"
      ]
    },
    {
      "name": "Wishtick (FAKE API — no backend needed)",
      "request": "launch",
      "type": "dart",
      "program": "${workspaceFolder}/wishtick_flutter/lib/main.dart",
      "cwd": "${workspaceFolder}/wishtick_flutter",
      "args": [
        "--dart-define=WISHTICK_FAKE_BACKEND=true"
      ]
    }
  ],
  "inputs": [
    {
      "id": "lanHost",
      "type": "promptString",
      "description": "This machine's LAN IP — the adapter the phone's Wi-Fi is on. PowerShell: Get-NetIPAddress -AddressFamily IPv4 | ? PrefixOrigin -eq Dhcp"
    }
  ]
}
