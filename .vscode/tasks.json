{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "adb reverse backend port",
      "type": "shell",
      // Forwards the physical device's own localhost:3000 to this machine's
      // backend over USB — no LAN IP involved, so it keeps working whichever
      // Wi-Fi network (or none) the phone and this machine are on.
      //
      // Reversed on *every* attached device rather than the implicit single
      // one. A bare `adb reverse` fails with "more than one device/emulator"
      // (exit 1) the moment a second handset is plugged in — even one that is
      // only charging — and VS Code then aborts the launch with a modal that
      // sends you to the Problems panel, where there is nothing to see: this
      // task contributes no diagnostics, only an exit code. Doing every device
      // is idempotent and removes the failure mode entirely.
      //
      // PowerShell, because this is a Windows workspace. On macOS/Linux the
      // equivalent is:
      //   adb devices | awk '/\tdevice$/{print $1}' | xargs -I{} adb -s {} reverse tcp:3000 tcp:3000
      "command": "adb devices | Select-String 'device$' | ForEach-Object { ($_ -split '\\s+')[0] } | ForEach-Object { adb -s $_ reverse tcp:3000 tcp:3000 }",
      "options": {
        "shell": {
          "executable": "powershell.exe",
          "args": ["-NoProfile", "-NonInteractive", "-Command"]
        }
      },
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}
